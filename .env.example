# REQUIRED: Docker Compose refuses to start the bot without these values.
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_ALLOWED_USER_ID=replace-with-your-user-id

# Optional API-Sports dashboard credential. It is held only by the bot-side
# gateway and is never inherited by Codex or entered through Telegram.
# API_FOOTBALL_KEY=replace-with-api-sports-key

# Optional repository-scoped Git publication. Configure all three values, copy
# docker-compose.git-publish.example.yml to docker-compose.git-publish.yml, and
# mount a directory containing only `deploy-key` and `known_hosts`. The deploy
# key should have write access to this one repository and no others.
# GIT_PUBLISH_REPOSITORY=/workspace/mental-models
# GIT_PUBLISH_REMOTE=git@github.com:julianlizarraga15/mental-models.git
# GIT_PUBLISH_BRANCH=main
# GIT_PUBLISH_SECRETS_DIR=/absolute/path/to/mental-models-publish-secrets

# Optional Codex-mode audio transcription. Create a dedicated OpenAI Platform
# key and place it in an owner-readable `api-key` file in this private directory
# outside the workspace. Copy docker-compose.transcription.example.yml to the
# ignored docker-compose.transcription.yml and include that override at runtime.
# OPENAI_TRANSCRIPTION_SECRETS_DIR=/absolute/path/to/openai-transcription-secrets
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Codex is the default conversational backend and uses ChatGPT device login.
# Its command network remains blocked. Public HTTPS file downloads use a
# separate exact-request gateway with one-time Telegram owner approval.
# AGENT_BACKEND=codex

# OPTIONAL FOR NORMAL BOT USE: most entries below show their existing default.
# Uncomment only to override it; self-deployment exceptions are labeled below.

# Responses rollback only: set AGENT_BACKEND=responses and explicitly add
# OPENAI_API_KEY to the bot environment in a local Compose override. The legacy
# cost-aware router uses the settings below.
# Cost-aware routing: nano answers simple messages, Luna handles ordinary chat/web,
# Terra handles routine computer work, and Sol handles difficult or deployment work.
# OPENAI_ROUTER_ENABLED=1
# OPENAI_ROUTER_MODEL=gpt-5-nano
# OPENAI_ECONOMY_MODEL=gpt-5.6-luna
# OPENAI_INTERMEDIATE_MODEL=gpt-5.6-terra
# OPENAI_MODEL=gpt-5.6
# OPENAI_ECONOMY_REASONING_EFFORT=low
# OPENAI_INTERMEDIATE_REASONING_EFFORT=low
# OPENAI_REASONING_EFFORT=medium
# OPENAI_TEXT_VERBOSITY=low
# OPENAI_ECONOMY_MAX_OUTPUT_TOKENS=4096
# OPENAI_INTERMEDIATE_MAX_OUTPUT_TOKENS=12288
# OPENAI_MAX_OUTPUT_TOKENS=16384
# OPENAI_COMPACT_THRESHOLD=32000
# OPENAI_TURN_WARNING_TOKENS=100000
# USAGE_DB_PATH=/workspace/.personal-agent-state/usage.sqlite3
# TRACE_DB_PATH=/trace-state/traces.sqlite3
# TRACE_RETENTION_DAYS=7
# TRACE_EXPORT_PART_BYTES=47185920

# Telegram image downloads are validated and limited to 10 MiB by default.
# TELEGRAM_MAX_IMAGE_BYTES=10485760
# Telegram documents are persisted without interpretation under
# telegram_uploads/ in the selected project and limited to 20 MB by default.
# TELEGRAM_MAX_DOCUMENT_BYTES=20000000
# Maximum size of each Codex-created image sent back through Telegram.
# TELEGRAM_MAX_OUTPUT_IMAGE_BYTES=10485760
# Maximum size of each safe workspace file sent back as a Telegram document.
# TELEGRAM_MAX_OUTPUT_DOCUMENT_BYTES=50000000
# Public HTTPS downloads require one-time owner approval and are capped at 50 MB.
# PUBLIC_DOWNLOAD_MAX_BYTES=50000000

# Voice notes and audio files are validated, transcribed, and limited to 20 MB
# and 10 minutes by default.
# TELEGRAM_MAX_AUDIO_BYTES=20000000
# TELEGRAM_MAX_AUDIO_SECONDS=600

# Container image overrides.
# WORKER_IMAGE=repository-worker:latest
# BOT_IMAGE=personal-agent-bot:latest
# DEPLOYER_IMAGE=personal-agent-deployer:latest

# OPTIONAL FOR NORMAL USE, REQUIRED FOR SELF-DEPLOYMENT: set these to valid
# absolute host paths before enabling self-deployment. WSL users should store
# the dedicated Git files under /home, not /mnt/c.
# HOST_WORKSPACE_DIR=/absolute/path/to/workspace
# GIT_SSH_KEY_PATH=/home/chulien/.ssh/personal-agent-github
# GIT_KNOWN_HOSTS_PATH=/home/chulien/.ssh/personal-agent-known_hosts

# Additional self-deployment overrides; defaults normally work unchanged.
# COMPOSE_PROJECT_NAME=personal-agent
# DEPLOY_REMOTE_URL=https://github.com/your-account/personal-agent.git
# DEPLOY_REMOTE_REF=refs/heads/main

# Optional when the Codex executable is not named `codex` in the worker image.
# CODEX_BIN=codex
