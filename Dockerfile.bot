FROM python:3.12-slim

RUN apt-get update \
    && apt-get install --no-install-recommends --yes docker.io docker-cli git openssh-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN git config --system --add safe.directory /workspace/personal-agent
COPY pyproject.toml README.md ./
COPY src ./src

RUN pip install --no-cache-dir .

ENTRYPOINT ["python", "-m", "telegram_bot"]
