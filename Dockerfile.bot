FROM ghcr.io/astral-sh/uv:0.11.32 AS uv

FROM python:3.12-slim

RUN apt-get update \
    && apt-get install --no-install-recommends --yes bubblewrap ca-certificates git openssh-client \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /bin/

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src

RUN pip install --no-cache-dir .

RUN test -x /usr/bin/bwrap \
    && test -x /bin/uv \
    && test -x /usr/bin/ssh \
    && test -x /usr/local/bin/codex-safe-launcher \
    && test -x /usr/local/bin/api-football \
    && test -x /usr/local/bin/api-football-mcp \
    && test -x /usr/local/bin/git-publish-mcp

ENTRYPOINT ["python", "-m", "telegram_bot"]
