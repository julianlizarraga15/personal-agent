FROM python:3.12-slim

RUN apt-get update \
    && apt-get install --no-install-recommends --yes docker.io docker-cli docker-compose git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN git config --system --add safe.directory /workspace/personal-agent
COPY src/deployment.py src/deployer.py src/owner_trace.py ./

ENTRYPOINT ["python", "-m", "deployer"]
